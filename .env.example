# Copy to .env and replace every placeholder.
TIGERGRAPH_HOST=https://your-workspace-host.tgcloud.io
TIGERGRAPH_GRAPH_NAME=FraudCaseGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=
TIGERGRAPH_SECRET=
TIGERGRAPH_TOKEN=
TIGERGRAPH_SAVANNA=
TIGERGRAPH_MCP_URL=http://localhost:8765
MCP_ENABLED=true
ALLOW_SIMULATED_EVIDENCE=true
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BACKUP_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_TIMEOUT_S=30
GRAPHRAG_PROVIDER=tigergraph
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=sqlite:///./fraud_cases.db
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-local-secret
