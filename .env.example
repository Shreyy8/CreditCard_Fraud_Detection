# ── LLM Configuration ────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# LLM_BACKUP_API_KEY=

# ── TigerGraph Data Plane (Savanna / Workspace) ─────────────────────────────
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH_NAME=FraudCaseGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=
# TIGERGRAPH_SECRET=
# TIGERGRAPH_TOKEN=

# ── TigerGraph Savanna Control Plane ─────────────────────────────────────────
TIGERGRAPH_SAVANNA=

# ── TigerGraph MCP ───────────────────────────────────────────────────────────
TIGERGRAPH_MCP_URL=http://localhost:8765
MCP_ENABLED=True
ALLOW_SIMULATED_EVIDENCE=True

# ── GraphRAG ─────────────────────────────────────────────────────────────────
GRAPHRAG_PROVIDER=tigergraph
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small

# ── App & Local Database ─────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./fraud_cases.db
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-key

# ── Dataset Paths ────────────────────────────────────────────────────────────
