# ── LLM Configuration ────────────────────────────────────────────────────────
# Option A: Free Google Gemini API (Recommended - Free Tier)
# Get a free key at: https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Option B: OpenAI API
# LLM_PROVIDER=openai
# LLM_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=

LLM_TIMEOUT_S=30.0
# LLM_BACKUP_API_KEY=

# ── TigerGraph Data Plane (Savanna / Workspace) ─────────────────────────────
TIGERGRAPH_HOST=https://your-workspace.i.tgcloud.io
TIGERGRAPH_GRAPH_NAME=FraudCaseGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your-tigergraph-password
# TIGERGRAPH_SECRET=
# TIGERGRAPH_TOKEN=

# ── TigerGraph Savanna Control Plane ─────────────────────────────────────────
TIGERGRAPH_SAVANNA=your-savanna-api-key-here

# ── TigerGraph MCP ───────────────────────────────────────────────────────────
TIGERGRAPH_MCP_URL=http://localhost:8765
MCP_ENABLED=True
ALLOW_SIMULATED_EVIDENCE=True

# ── GraphRAG ─────────────────────────────────────────────────────────────────
GRAPHRAG_PROVIDER=tigergraph
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small

# ── App & Local Database ─────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./fraud_cases.db
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-key

# ── Dataset Paths ────────────────────────────────────────────────────────────
TRANSACTIONS_CSV=DataSet/transactions.csv
TRANSACTION_CARDS_CSV=artifacts/transaction_cards.csv
IDENTITY_CSV=DataSet/identity.csv
CLOSED_CASES_CSV=DataSet/closed_cases_history.csv
CASE_PACK_CSV=DataSet/case_pack.csv

